{
  "name": "life-inbox",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@8.11.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --parallel --filter @life-inbox/web --filter @life-inbox/api dev",
    "dev:web": "pnpm --filter @life-inbox/web dev",
    "dev:api": "pnpm --filter @life-inbox/api dev",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:api": "pnpm --filter @life-inbox/api test",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @life-inbox/api db:generate",
    "db:migrate": "pnpm --filter @life-inbox/api db:migrate",
    "db:push": "pnpm --filter @life-inbox/api db:push",
    "db:studio": "pnpm --filter @life-inbox/api db:studio",
    "db:check": "pnpm --filter @life-inbox/api db:check"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.7.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0"
  }
}
