{
  "name": "@life-inbox/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "test": "vitest run",
    "db:prepare": "node scripts/ensure-pgvector.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "pnpm db:prepare && drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:check": "drizzle-kit check",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.25",
    "@langchain/core": "^1.2.8",
    "@langchain/langgraph": "^1.4.10",
    "@langchain/openai": "^1.5.8",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/mapped-types": "*",
    "@nestjs/platform-express": "11.1.28",
    "ai": "^7.0.44",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "langchain": "^1.5.9",
    "langsmith": "^0.8.11",
    "pg": "8.22.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.1.28",
    "@types/node": "22.18.12",
    "@types/pg": "8.15.5",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  }
